# Backend
IDLRAG_ENVIRONMENT=development
IDLRAG_BASE_DIR=./data
IDLRAG_AUTH_SECRET=replace-with-a-long-random-secret
IDLRAG_PREVIOUS_AUTH_SECRETS=
IDLRAG_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# Import limits
IDLRAG_IMPORT_ROOTS=
IDLRAG_ALLOW_ARBITRARY_IMPORT_PATH=false
IDLRAG_MAX_UPLOAD_FILES=20
IDLRAG_MAX_UPLOAD_FILE_MB=50
IDLRAG_MAX_UPLOAD_TOTAL_MB=200
IDLRAG_MAX_PDF_PAGES=300

# Local IDL execution. Only user-owned chat .pro artifacts can be run.
# Use the licensed command-line IDL interpreter (idl.exe). Workbench/ENVI
# GUI launchers and idlrt.exe are rejected for project .pro execution.
IDLRAG_IDL_EXECUTABLE=idl
IDLRAG_IDL_RUN_TIMEOUT_SECONDS=30
IDLRAG_IDL_RUN_MAX_STDOUT_CHARS=20000
IDLRAG_IDL_RUN_MAX_STDERR_CHARS=20000
IDLRAG_IDL_RUN_MAX_OUTPUT_FILES=12
IDLRAG_IDL_RUN_MAX_OUTPUT_FILE_MB=20
IDLRAG_IDL_RUN_ALLOWED_OUTPUT_SUFFIXES=.png,.jpg,.jpeg,.tif,.tiff,.bmp,.gif
IDLRAG_IDL_RUN_ALLOWED_INPUT_SUFFIXES=.tif,.tiff,.dat,.sav,.csv,.json,.geojson
IDLRAG_IDL_RUN_MAX_INPUT_FILES=8
IDLRAG_IDL_RUN_MAX_INPUT_FILE_MB=200

# Google Earth Engine data acquisition. Keep disabled until credentials are configured locally.
# Local development usually uses ADC after: uv run --project backend python -c "import ee; ee.Authenticate(auth_mode='localhost')"
IDLRAG_GEE_ENABLED=false
IDLRAG_GEE_PROJECT=
IDLRAG_GEE_AUTH_MODE=adc
IDLRAG_GEE_SERVICE_ACCOUNT_EMAIL=
IDLRAG_GEE_SERVICE_ACCOUNT_KEY_JSON=
IDLRAG_GEE_ALLOWED_DATASETS=CGIAR/SRTM90_V4,COPERNICUS/S2_SR_HARMONIZED,LANDSAT/LC08/C02/T1_L2
IDLRAG_GEE_MAX_DOWNLOAD_MB=100
IDLRAG_GEE_DOWNLOAD_TIMEOUT_SECONDS=120
IDLRAG_GEE_MAX_BBOX_DEGREES=5
IDLRAG_GEE_MAX_BANDS=12
IDLRAG_GEE_MIN_SCALE=1
IDLRAG_GEE_MAX_SCALE=10000

# Public literature discovery. The key is optional and is sent only as x-api-key to Semantic Scholar.
IDLRAG_SEMANTIC_SCHOLAR_API_KEY=
IDLRAG_RESEARCH_SEMANTIC_SCHOLAR_MIN_INTERVAL_SECONDS=0.25

# Keep true for the local single-process app. Docker Compose disables the API
# thread and runs the standalone index worker service instead.
IDLRAG_INDEX_WORKER_ENABLED=true
IDLRAG_RESEARCH_RUN_TIMEOUT_MINUTES=120

# Default model settings. Real API keys are configured locally or through the app settings page.
IDLRAG_DEFAULT_PROVIDER_NAME=openai-compatible
IDLRAG_DEFAULT_API_BASE_URL=https://api.openai.com/v1
IDLRAG_DEFAULT_CHAT_MODEL=gpt-4.1-mini
IDLRAG_DEFAULT_EMBEDDING_MODEL=text-embedding-3-small
IDLRAG_EMBEDDING_DIMENSIONS=1536

# Frontend
VITE_API_BASE_URL=http://127.0.0.1:8000/api
